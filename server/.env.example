# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Required in production. Use a long random secret.
IP_HASH_SALT=replace-with-a-long-random-secret

# Optional tuning
HOLD_TIMER_MS=2500
INTEREST_FALLBACK_MS=5000
BOT_MAX_RATIO=0.3
MSG_RATE_LIMIT=6
MSG_RATE_WINDOW_MS=10000
SKIP_COOLDOWN_MS=3000
BAN_REPORT_THRESHOLD=3
BAN_DURATION_MS=86400000
MAX_MESSAGE_LEN=500
